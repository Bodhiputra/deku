{
  "mcpServers": {
    "reddit": {
      "command": "uvx",
      "args": ["mcp-reddit"]
    },
    "chrome": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--autoConnect"]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--config",
        ".playwright-mcp-config.json"
      ]
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
