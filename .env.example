# Local secrets for Deku — copy to .env and fill in. Never commit .env.
# setup.sh creates .env on first run if missing.

# Machine path (optional — scripts default to repo root)
PROJECT_ROOT=

# Notion integration token — used by Node tools (sync-kol-list, notion-upload)
# Notion MCP in Cursor/Claude/Codex uses OAuth separately; this key is for scripts.
# Jinu walks new users through creating one when they start KOL discovery (see MANUAL.md §6).
NOTION_API_KEY=

# Notion KOL Pools database ID — for tools/sync-kol-list.js (or set in brand-context.md Documentation)
NOTION_KOL_DATABASE_ID=

# Optional — speeds up YouTube KOL discovery. Jinu offers setup before KOL tasks (see MANUAL.md §6).
YOUTUBE_API_KEY=

# Google Analytics MCP (Jinu — ga4-analytics skill). See .claude/skills/ga4-analytics/references/setup.md
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_PROJECT_ID=
GA4_PROPERTY_ID=
